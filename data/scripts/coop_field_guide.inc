	.string "ROLYCOLY$"
Coop_Text_FG_Where7:
	.string "RUSTURF TUNNEL and NEW MAUVILLE.$"
Coop_Text_FG_Evo7:
	.string "Level 18: CARKOL.\n"
	.string "Level 34: COALOSSAL.$"
