	.string "GALAR FORMS$"
Coop_Text_FG_Where3_1:
	.string "MEOWTH: ROUTE 115. PONYTA and\n"
	.string "FARFETCH'D: SAFARI ZONE. SLOWPOKE,\lSTUNFISK: surf ROUTES 120, 114.$"
Coop_Text_FG_Evo3_1:
