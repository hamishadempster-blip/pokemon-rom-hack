Coop_Text_FG_Name6:
	.string "SUNKERN$"
Coop_Text_FG_Where6:
	.string "ROUTE 116, ROUTE 123 and the\n"
	.string "SAFARI ZONE.$"
Coop_Text_FG_Evo6:
	.string "A SUN STONE: SUNFLORA, now\n"
	.string "GRASS and FIRE. VERDANTURF and\lLILYCOVE sell SUN STONES.$"
