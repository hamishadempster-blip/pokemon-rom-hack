	.string "PORYGON$"
Coop_Text_FG_Where34:
	.string "A sealed chamber in NEW MAUVILLE.\n"
	.string "Old log pages show the way.$"
Coop_Text_FG_Evo34:
	.string "An UP-GRADE: PORYGON2. A DUBIOUS\n"
	.string "DISC: PORYGON-Z. MAUVILLE sells both.$"
